rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Check if user is registered Super Admin
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN';
    }

    // Check the role stored in the authoritative user profile.
    function hasUserRole(role) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isPublicUser() {
      return hasUserRole('PUBLIC_USER');
    }

    // Retrieve officer record for current user
    function getPoliceDoc() {
      return get(/databases/$(database)/documents/policeUsers/$(request.auth.uid)).data;
    }

    // Check if user is an active police officer
    function isPolice() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/policeUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/policeUsers/$(request.auth.uid)).data.isActive == true;
    }

    // Check if police officer belongs to the assigned Thana
    function isAssignedPolice(thanaId) {
      return isPolice() && getPoliceDoc().assignedThanaId == thanaId;
    }

    // ==========================================
    // Users Collection
    // ==========================================
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId &&
        incoming().role == 'PUBLIC_USER' &&
        incoming().uid == userId &&
        incoming().keys().hasAll(['uid', 'fullName', 'email', 'role', 'createdAt']);
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
         incoming().role == existing().role &&
         incoming().uid == existing().uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phoneNumber', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // Police Users Collection (Admin managed)
    // ==========================================
    match /policeUsers/{policeId} {
      allow get: if isSignedIn() && (request.auth.uid == policeId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // Admins Collection
    // ==========================================
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // Reports Collection
    // ==========================================
    match /reports/{reportId} {
      // Public user can read ONLY their own report. Police can read ONLY if assigned to their Thana. Admin can read all.
      allow get: if isSignedIn() && (
        existing().reporterId == request.auth.uid ||
        isAssignedPolice(existing().assignedThanaId) ||
        isAdmin()
      );

      // Query listings enforced by security rules
      allow list: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid) || (isPolice() && resource.data.assignedThanaId == getPoliceDoc().assignedThanaId);

      // Creation by authenticated citizen
      allow create: if isSignedIn() &&
        incoming().reporterId == request.auth.uid &&
        incoming().status == 'SUBMITTED' &&
        incoming().keys().hasAll(['reportId', 'reporterId', 'incidentType', 'description', 'jurisdiction', 'assignedThanaId', 'status', 'createdAt']) &&
        incoming().reportId == reportId &&
        incoming().jurisdiction.thanaId == incoming().assignedThanaId &&
        incoming().jurisdiction.districtId is string &&
        incoming().jurisdiction.upazilaId is string &&
        incoming().jurisdiction.thanaId is string;

      // Update actions:
      // Police can update status and investigation notes for their assigned Thana
      // Reporter cannot tamper with report once submitted
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isAssignedPolice(existing().assignedThanaId) &&
          incoming().reporterId == existing().reporterId &&
          incoming().reportId == existing().reportId &&
          incoming().assignedThanaId == existing().assignedThanaId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'policeNotes', 'actionTakenDetails', 'updatedAt'])
        )
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // Reported Person Collection (Strictly Confidential)
    // NEVER accessible by general public or other citizens
    // ==========================================
    match /reportedPersons/{personId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        (
          isPolice() &&
          exists(/databases/$(database)/documents/reports/$(existing().reportId)) &&
          get(/databases/$(database)/documents/reports/$(existing().reportId)).data.assignedThanaId == getPoliceDoc().assignedThanaId
        )
      );

      allow list: if isAdmin();

      allow create: if isSignedIn() &&
        incoming().keys().hasAll(['id', 'personId', 'reportId', 'createdAt']) &&
        incoming().keys().hasOnly(['id', 'personId', 'reportId', 'name', 'alias', 'approximateAge', 'gender', 'description', 'knownArea', 'additionalNotes', 'photoEvidenceId', 'createdAt']) &&
        incoming().id == personId &&
        incoming().personId == personId &&
        incoming().reportId is string &&
        incoming().createdAt is string &&
        (!incoming().keys().hasAny(['name']) || (incoming().name is string && incoming().name.size() <= 200)) &&
        (!incoming().keys().hasAny(['alias']) || (incoming().alias is string && incoming().alias.size() <= 200)) &&
        (!incoming().keys().hasAny(['approximateAge']) || (incoming().approximateAge is int && incoming().approximateAge >= 0 && incoming().approximateAge <= 120)) &&
        (!incoming().keys().hasAny(['gender']) || (incoming().gender is string && incoming().gender.size() <= 50)) &&
        (!incoming().keys().hasAny(['description']) || (incoming().description is string && incoming().description.size() <= 5000)) &&
        (!incoming().keys().hasAny(['knownArea']) || (incoming().knownArea is string && incoming().knownArea.size() <= 500)) &&
        (!incoming().keys().hasAny(['additionalNotes']) || (incoming().additionalNotes is string && incoming().additionalNotes.size() <= 5000)) &&
        (!incoming().keys().hasAny(['photoEvidenceId']) || (incoming().photoEvidenceId is string && incoming().photoEvidenceId.size() <= 128)) &&
        getAfter(/databases/$(database)/documents/reports/$(incoming().reportId)).data.reporterId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/reports/$(incoming().reportId)).data.reportedPersonId == personId &&
        getAfter(/databases/$(database)/documents/reports/$(incoming().reportId)).data.hasReportedPerson == true;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // Evidence Metadata Collection
    // ==========================================
    match /evidence/{evidenceId} {
      allow get: if isSignedIn() && (
        existing().uploadedBy == request.auth.uid ||
        isAdmin() ||
        (
          isPolice() &&
          exists(/databases/$(database)/documents/reports/$(existing().reportId)) &&
          get(/databases/$(database)/documents/reports/$(existing().reportId)).data.assignedThanaId == getPoliceDoc().assignedThanaId
        )
      );

      allow list: if isAdmin() || (isSignedIn() && resource.data.uploadedBy == request.auth.uid);

      // Evidence is persisted only through the authenticated backend route,
      // which also coordinates Telegram storage and the parent report.
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // Audit Logs Collection (Append-only / Super Admin read)
    // ==========================================
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();

      // Clients may append only an audit event for themselves, with a role
      // matching the authoritative users profile. If the event references a
      // report/evidence, it must belong to a report the caller is allowed to access.
      allow create: if isSignedIn() &&
        incoming().logId == logId &&
        incoming().userId == request.auth.uid &&
        incoming().role == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role &&
        (
          !incoming().keys().hasAny(['reportId']) ||
          (
            exists(/databases/$(database)/documents/reports/$(incoming().reportId)) &&
            (
              isAdmin() ||
              (isPublicUser() &&
                get(/databases/$(database)/documents/reports/$(incoming().reportId)).data.reporterId == request.auth.uid) ||
              (isPolice() &&
                get(/databases/$(database)/documents/reports/$(incoming().reportId)).data.assignedThanaId == getPoliceDoc().assignedThanaId)
            )
          )
        ) &&
        (
          !incoming().keys().hasAny(['evidenceId']) ||
          (
            exists(/databases/$(database)/documents/evidence/$(incoming().evidenceId)) &&
            (
              isAdmin() ||
              get(/databases/$(database)/documents/evidence/$(incoming().evidenceId)).data.uploadedBy == request.auth.uid ||
              (
                isPolice() &&
                exists(/databases/$(database)/documents/reports/$(get(/databases/$(database)/documents/evidence/$(incoming().evidenceId)).data.reportId)) &&
                get(/databases/$(database)/documents/reports/$(get(/databases/$(database)/documents/evidence/$(incoming().evidenceId)).data.reportId)).data.assignedThanaId == getPoliceDoc().assignedThanaId
              )
            )
          )
        );

      allow update, delete: if false; // Immutable audit trail
    }

    // ==========================================
    // Notifications Collection
    // ==========================================
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && (
        (isPolice() && resource.data.targetThanaId == getPoliceDoc().assignedThanaId) ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );

      // A notification must be tied to an authorized workflow:
      // citizen -> assigned police station, or police -> the report owner.
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          isPublicUser() &&
          incoming().keys().hasAll(['reportId', 'targetThanaId']) &&
          !incoming().keys().hasAny(['recipientId']) &&
          exists(/databases/$(database)/documents/reports/$(incoming().reportId)) &&
          get(/databases/$(database)/documents/reports/$(incoming().reportId)).data.reporterId == request.auth.uid &&
          incoming().targetThanaId == get(/databases/$(database)/documents/reports/$(incoming().reportId)).data.assignedThanaId
        ) ||
        (
          isPolice() &&
          incoming().keys().hasAll(['reportId', 'recipientId']) &&
          !incoming().keys().hasAny(['targetThanaId']) &&
          exists(/databases/$(database)/documents/reports/$(incoming().reportId)) &&
          get(/databases/$(database)/documents/reports/$(incoming().reportId)).data.assignedThanaId == getPoliceDoc().assignedThanaId &&
          incoming().recipientId == get(/databases/$(database)/documents/reports/$(incoming().reportId)).data.reporterId
        )
      );

      allow update: if isSignedIn() && (
        (isPolice() && existing().targetThanaId == getPoliceDoc().assignedThanaId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])) ||
        (existing().recipientId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // Public Reference Data (Districts, Upazilas, Thanas, Unions, Categories, Aggregated Statistics)
    // ==========================================
    match /districts/{districtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /upazilas/{upazilaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /thanas/{thanaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /unions/{unionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicStatistics/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepageBanners/{bannerId} {
      allow read: if resource.data.isActive == true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
